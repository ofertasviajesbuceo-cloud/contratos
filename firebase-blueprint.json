    "AgencyProfile": {
      "title": "AgencyProfile",
      "description": "Configuración legal, fiscal y bancaria de la agencia de viajes.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commercialName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "legalHolderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "cif": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "licenseNote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "addressLine1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "addressLine2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "iban": {
          "type": "string",
          "minLength": 5,
          "maxLength": 64
        },
        "bic": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32
        },
        "bankBeneficiary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "footerText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "jurisdictionCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "publicDomain": {
          "type": "string",
          "minLength": 0,
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+)?$"
        },
        "insurancePolicies": {
          "type": "array",
          "description": "Listado de pólizas de seguro configuradas (máximo 20)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "commercialName",
        "legalHolderName",
        "cif",
        "licenseNote",
        "addressLine1",
        "addressLine2",
        "phone",
        "email",
        "iban",
        "bic",
        "bankBeneficiary",
        "footerText",
        "jurisdictionCity",
        "createdAt",
        "updatedAt"
      ]
    },
