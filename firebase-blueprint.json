  "firestore": {
    "/agencyProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/AgencyProfile"
      },
      "description": "Configuración privada de la agencia perteneciente al usuario autenticado."
    },
    "/clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/Client"
      },
      "description": "Clientes de la agencia aislados por ownerId."
    },
    "/templates/{templateId}": {
      "schema": {
        "$ref": "#/entities/TripTemplate"
      },
      "description": "Plantillas editables de viajes aisladas por ownerId."
    },
    "/contracts/{contractId}": {
      "schema": {
        "$ref": "#/entities/TravelContract"
      },
      "description": "Contratos de viaje generados para clientes, aislados por ownerId."
    },
    "/accessUsers/{accessUserId}": {
      "schema": {
        "$ref": "#/entities/AccessUser"
      },
      "description": "Usuarios de acceso al workspace de la agencia aislados por ownerId."
    },
    "/signatureRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/SignatureRequest"
      },
      "description": "Solicitudes de firma remota por enlace único para clientes."
    }
  }
}
